{
  "name": "maeul-in-the-sky",
  "version": "2.0.0",
  "description": "Build an animated isometric village from your GitHub contributions",
  "type": "module",
  "bin": {
    "maeul-sky": "dist/index.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "prebuild": "npm run check:pixel",
    "build": "tsup && npm run build:demo && tsx scripts/package-runtime-assets.ts",
    "build:demo": "tsx scripts/build-demo.ts && npm run build:world && npm run build:tour",
    "build:tour": "tsx scripts/build-tour.ts",
    "build:world": "tsx scripts/build-world.ts",
    "render:profile": "tsx scripts/render-profile.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:artifact": "npm run build && tsx scripts/smoke-package.ts",
    "test:browser": "playwright test",
    "test:browser:update": "MAEUL_VISUAL_BASELINE=1 playwright test tests/visual/static.spec.ts tests/visual/world-static.spec.ts --project=chromium-desktop --update-snapshots",
    "generate:demo": "npm run check:pixel && tsx scripts/generate-demo.ts && npm run build:demo",
    "generate:pixel": "tsx scripts/pixel/generate.ts",
    "check:pixel": "tsx scripts/pixel/generate.ts --check",
    "prepare:wildlife": "tsx scripts/wildlife/prepare.ts",
    "check:wildlife": "vitest run --project=unit tests/tour/wildlife-assets.test.ts",
    "generate:catalog": "tsx scripts/generate-catalog.ts docs/demo/catalog",
    "check:catalog": "tsx scripts/catalog/check-generated.ts docs/demo/catalog",
    "benchmark": "tsx scripts/benchmark/render.ts",
    "lint": "eslint src/ tests/ scripts/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepare": "husky",
    "prepare:authored": "tsx scripts/authored/check.ts --write",
    "check:authored": "tsx scripts/authored/check.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github",
    "github-action",
    "contribution",
    "contribution-calendar",
    "svg",
    "animation",
    "terrain",
    "isometric",
    "visualization",
    "profile",
    "profile-readme",
    "readme"
  ],
  "author": "t1seo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t1seo/maeul-in-the-sky.git"
  },
  "homepage": "https://github.com/t1seo/maeul-in-the-sky",
  "bugs": {
    "url": "https://github.com/t1seo/maeul-in-the-sky/issues"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "commander": "^14.0.3",
    "css-tree": "3.2.1",
    "saxes": "6.0.0",
    "simplex-noise": "^4.0.3",
    "zod": "^4.6.4"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/css-tree": "2.3.11",
    "@types/culori": "^4.0.1",
    "@types/node": "^25.9.5",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "culori": "^4.0.2",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "ky": "2.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "sharp": "0.35.4",
    "svgo": "^4.1.0",
    "three": "0.186.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  }
}
